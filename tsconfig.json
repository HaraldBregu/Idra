{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"types": [
			"node",
			"vite/client"
		],
		"jsx": "react-jsx"
	},
	"include": [
		"src/**/*.ts",
		"client/**/*.ts",
		"client/**/*.tsx",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
