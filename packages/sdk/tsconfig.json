{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"rootDir": "../..",
		"outDir": "dist"
	},
	"include": ["index.ts"]
}
