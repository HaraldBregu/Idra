{
	"name": "@friday/sdk",
	"version": "0.1.0",
	"description": "Typed client for the Friday desktop app API",
	"type": "module",
	"main": "./dist/packages/sdk/index.js",
	"types": "./dist/packages/sdk/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/packages/sdk/index.d.ts",
			"default": "./dist/packages/sdk/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HaraldBregu/friday.git",
		"directory": "packages/sdk"
	},
	"homepage": "https://github.com/HaraldBregu/friday/tree/main/packages/sdk#readme",
	"bugs": {
		"url": "https://github.com/HaraldBregu/friday/issues"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json && node postbuild.js",
		"smoke": "npm run build && node smoke.js",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"friday",
		"sdk"
	],
	"author": "Harald Bregu <harald.bregu@gmail.com>",
	"license": "MIT"
}
