{
  "providerId": "nomic",
  "providerName": "Nomic",
  "apiKeyUrl": "https://atlas.nomic.ai",
  "images_url": "/images",
  "services": [
    {
      "id": "nomic-embed-text-v2-moe",
      "name": "Nomic Embed v2",
      "type": "embedding-model",
      "url": "https://api-atlas.nomic.ai/v1",
      "metadata": {
        "documentationUrl": "https://docs.nomic.ai/atlas/capabilities/embeddings",
        "documentationStatus": "verified",
        "inputs": {
          "texts": {
            "type": "array",
            "required": true
          },
          "task_type": {
            "type": "string",
            "enum": [
              "search_query",
              "search_document",
              "classification",
              "clustering"
            ]
          },
          "dimensionality": {
            "type": "integer"
          },
          "long_text_mode": {
            "type": "string",
            "enum": [
              "truncate",
              "mean_pool"
            ]
          }
        }
      }
    }
  ]
}

