{
  "providerId": "runway",
  "providerName": "Runway",
  "apiKeyUrl": "https://dev.runwayml.com",
  "images_url": "/images",
  "icon_dark_url": "/images/fallback_lobehub/png_dark/runway.png",
  "icon_light_url": "/images/fallback_lobehub/png_light/runway.png",
  "services": [
    {
      "id": "gen4.5",
      "name": "Gen-4.5",
      "type": "text-to-video-model",
      "url": "https://api.dev.runwayml.com/v1",
      "metadata": {
        "documentationUrl": "https://docs.dev.runwayml.com/api/",
        "documentationStatus": "verified",
        "inputs": {
          "promptText": {
            "type": "string",
            "required": true
          },
          "ratio": {
            "type": "string",
            "enum": [
              "1280:720",
              "720:1280"
            ]
          },
          "duration": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "contentModeration": {
            "type": "object"
          }
        }
      }
    }
  ]
}
