  "icon_light_url": "/images/fallback_lobehub/png_light/runway.png",
  "services": [
    {
      "id": "gen4_turbo",
      "name": "Gen-4 Turbo",
      "type": "text-to-video-model",
      "url": "https://api.dev.runwayml.com/v1",
      "metadata": {
        "documentationUrl": "https://docs.dev.runwayml.com/api/",
        "documentationStatus": "verified",
        "inputs": {
          "promptImage": {
            "type": "string",
            "required": true
          },
          "promptText": {
            "type": "string",
            "required": true
          },
          "ratio": {
            "type": "string",
            "enum": [
              "1280:720",
              "720:1280",
              "1104:832",
              "832:1104",
              "960:960",
              "1584:672"
            ]
          },
          "duration": {
            "type": "integer",
            "enum": [5, 10]
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "contentModeration": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "gen3a_turbo",
      "name": "Gen-3 Alpha Turbo",
      "type": "text-to-video-model",
      "url": "https://api.dev.runwayml.com/v1",
      "metadata": {
        "documentationUrl": "https://docs.dev.runwayml.com/api/",
        "documentationStatus": "verified",
        "inputs": {
          "promptImage": {
            "type": "string",
            "required": true
          },
          "promptText": {
            "type": "string",
            "required": true
          },
          "ratio": {
            "type": "string"
          },
          "duration": {
            "type": "integer",
            "enum": [5, 10]
          },
          "seed": {
            "type": "integer"
          }
        }
      }
    }
  ]
