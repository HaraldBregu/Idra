{
  "providerId": "runway",
  "providerName": "Runway",
  "apiKeyUrl": "https://dev.runwayml.com",
  "images_url": "/images",
  "icon_dark_url": "/images/fallback_lobehub/png_dark/runway.png",
  "icon_light_url": "/images/fallback_lobehub/png_light/runway.png",
  "services": [
    {
      "id": "gen4_turbo",
      "name": "Gen-4 Turbo",
      "type": "text-to-video-model",
      "url": "https://api.dev.runwayml.com/v1",
      "metadata": {
        "documentationUrl": "https://docs.dev.runwayml.com/",
        "inputs": {
          "ratio": {
            "type": "string",
            "enum": [
              "1280:720",
              "720:1280",
              "1104:832",
              "832:1104"
            ]
          },
          "duration": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "seed": {
            "type": "integer"
          }
        }
      }
    },
    {
      "id": "gen3a_turbo",
      "name": "Gen-3 Alpha Turbo",
      "type": "text-to-video-model",
      "url": "https://api.dev.runwayml.com/v1",
      "metadata": {
        "documentationUrl": "https://docs.dev.runwayml.com/",
        "inputs": {
          "ratio": {
            "type": "string",
            "enum": [
              "1280:720",
              "720:1280",
              "1104:832",
              "832:1104"
            ]
          },
          "duration": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "seed": {
            "type": "integer"
          }
        }
      }
    }
  ]
}

