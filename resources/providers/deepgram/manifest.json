{
  "providerId": "deepgram",
  "providerName": "Deepgram",
  "apiKeyUrl": "https://console.deepgram.com",
  "images_url": "/images",
  "icon_dark_url": "/images/fallback_simpleicons/png/deepgram.png",
  "icon_light_url": "/images/fallback_simpleicons/png/deepgram.png",
  "services": [
    {
      "id": "nova-3",
      "name": "Nova 3",
      "apiTypes": [
        "batch",
        "stream"
      ],
      "type": "speech-to-text-model",
      "url": "https://api.deepgram.com/v1",
      "sampleRate": 24000,
      "metadata": {
        "documentationUrl": "https://developers.deepgram.com/docs/model",
        "documentationStatus": "verified",
        "inputs": {
          "language": {
            "type": "string"
          },
          "smart_format": {
            "type": "boolean"
          },
          "punctuate": {
            "type": "boolean"
          },
          "utterances": {
            "type": "boolean"
          },
          "paragraphs": {
            "type": "boolean"
          },
          "diarize_model": {
            "type": "string",
            "enum": [
              "latest",
              "v1",
              "v2"
            ]
          },
          "keyterm": {
            "type": "array"
          },
          "alternatives": {
            "type": "integer"
          },
          "detect_language": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "id": "flux-general-en",
      "name": "Flux",
      "apiTypes": [
        "stream"
      ],
      "realtime": true,
      "type": "speech-to-text-model",
      "url": "https://api.deepgram.com/v1",
      "sampleRate": 24000,
      "metadata": {
        "documentationUrl": "https://developers.deepgram.com/docs/model",
        "documentationStatus": "verified",
        "inputs": {
          "language_hint": {
            "type": "string"
          },
          "eot_threshold": {
            "type": "number"
          },
          "eot_timeout_ms": {
            "type": "integer"
          },
          "eager_eot_threshold": {
            "type": "number"
          },
          "encoding": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer"
          }
        }
      }
    },
    {
      "id": "aura-2",
      "name": "Aura 2",
      "type": "text-to-speech-model",
      "url": "https://api.deepgram.com/v1",
      "metadata": {
        "documentationUrl": "https://developers.deepgram.com/docs/model",
        "documentationStatus": "verified",
        "inputs": {
          "encoding": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer"
          },
          "container": {
            "type": "string"
          },
          "bit_rate": {
            "type": "integer"
          },
          "callback": {
            "type": "string"
          }
        }
      }
    }
  ]
}

