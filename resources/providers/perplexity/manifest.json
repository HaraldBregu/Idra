{
	"providerId": "perplexity",
	"providerName": "Perplexity",
	"apiKeyUrl": "https://www.perplexity.ai/settings/api",
	"images_url": "/images",
	"icon_dark_url": "/images/fallback_lobehub/png_dark/perplexity-color.png",
	"icon_light_url": "/images/fallback_lobehub/png_light/perplexity-color.png",
	"services": [
		{
			"id": "sonar-deep-research",
			"name": "Sonar Deep Research",
			"type": "research-chat-model",
			"url": "https://api.perplexity.ai",
			"metadata": {
				"promptAttachments": [
					{
						"kind": "image",
						"mimeTypes": ["image/jpeg", "image/png", "image/webp"],
						"extensions": [".jpg", ".jpeg", ".png", ".webp"]
					},
					{ "kind": "document", "mimeTypes": ["application/pdf"], "extensions": [".pdf"] }
				],
				"documentationUrl": "https://docs.perplexity.ai/api-reference/sonar-post",
				"documentationStatus": "verified",
				"inputs": {
					"max_tokens": {
						"type": "integer",
						"minimum": 1,
						"maximum": 128000
					},
					"temperature": {
						"type": "number",
						"minimum": 0,
						"maximum": 2
					},
					"top_p": {
						"type": "number"
					},
					"top_k": {
						"type": "integer"
					},
					"presence_penalty": {
						"type": "number"
					},
					"frequency_penalty": {
						"type": "number"
					},
					"stop": {
						"type": "array"
					},
					"response_format": {
						"type": "object"
					},
					"search_domain_filter": {
						"type": "array"
					},
					"search_recency_filter": {
						"type": "string"
					},
					"search_after_date_filter": {
						"type": "string"
					},
					"search_before_date_filter": {
						"type": "string"
					},
					"web_search_options": {
						"type": "object"
					},
					"search_context_size": {
						"type": "string"
					},
					"reasoning_effort": {
						"type": "string",
						"enum": ["low", "medium", "high"]
					}
				}
			}
		},
