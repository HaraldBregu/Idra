{
  "providerId": "stability-ai",
  "providerName": "Stability AI",
  "apiKeyUrl": "https://platform.stability.ai/account/keys",
  "images_url": "/images",
  "icon_dark_url": "/images/fallback_lobehub/png_dark/stability-color.png",
  "icon_light_url": "/images/fallback_lobehub/png_light/stability-color.png",
  "services": [
    {
      "id": "stable-image-ultra",
      "name": "Stable Image Ultra",
      "type": "text-to-image-model",
      "url": "https://api.stability.ai/v2beta",
      "metadata": {
        "documentationUrl": "https://platform.stability.ai/docs/api-reference",
        "documentationStatus": "verified",
        "inputs": {
          "aspect_ratio": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "output_format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ]
          },
          "style_preset": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "stable-image-core",
      "name": "Stable Image Core",
      "type": "text-to-image-model",
      "url": "https://api.stability.ai/v2beta",
      "metadata": {
        "documentationUrl": "https://platform.stability.ai/docs/api-reference",
        "documentationStatus": "verified",
        "inputs": {
          "aspect_ratio": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "output_format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ]
          }
        }
      }
    },
    {
      "id": "stable-audio-2.5",
      "name": "Stable Audio 2.5",
      "type": "text-to-audio-model",
      "url": "https://api.stability.ai/v2beta",
      "metadata": {
        "documentationUrl": "https://platform.stability.ai/docs/api-reference",
        "documentationStatus": "verified",
        "inputs": {
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 190
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967294
          },
          "steps": {
            "type": "integer",
            "minimum": 4,
            "maximum": 8
          },
          "cfg_scale": {
            "type": "number",
            "minimum": 1,
            "maximum": 25
          },
          "output_format": {
            "type": "string",
            "enum": [
              "mp3",
              "wav"
            ]
          }
        }
      }
    }
  ]
}

