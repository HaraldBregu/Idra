{
  "providerId": "cloudflare",
  "providerName": "CloudFlare",
  "apiKeyUrl": "https://dash.cloudflare.com",
  "images_url": "/images",
  "services": [
    {
      "id": "object-storage",
      "name": "Object Storage",
      "url": "https://r2.cloudflarestorage.com",
      "type": "storage",
      "metadata": {
        "documentationUrl": "https://developers.cloudflare.com/r2/api/workers/workers-api-reference/",
        "documentationStatus": "verified",
        "inputs": {
          "httpMetadata": {
            "type": "object"
          },
          "customMetadata": {
            "type": "object"
          },
          "storageClass": {
            "type": "string",
            "enum": [
              "Standard",
              "InfrequentAccess"
            ]
          },
          "md5": {
            "type": "string"
          },
          "onlyIf": {
            "type": "object"
          }
        }
      }
    }
  ]
}

