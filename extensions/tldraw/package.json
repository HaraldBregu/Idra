{
	"name": "friday-tldraw",
	"private": true,
	"version": "1.0.0",
	"description": "Create diagrams, whiteboards, and visual notes on a persistent tldraw canvas in Friday.",
	"keywords": [
		"utility"
	],
	"main": "dist/index.html",
	"files": [
		"dist",
		"manifest.json"
	],
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && vite build",
		"prepack": "npm run build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@friday/sdk": "file:../../packages/sdk",
		"@tldraw/assets": "5.3.0",
		"@tldraw/sync": "5.3.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"tldraw": "5.3.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.0.4",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
	}
}
