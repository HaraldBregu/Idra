		"preview": "vite preview"
	},
	"dependencies": {
		"@friday/sdk": "file:../../packages/sdk",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@tldraw/assets": "5.3.0",
		"@tldraw/sync": "5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.8.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"tailwind-merge": "^3.4.0",
		"tldraw": "5.3.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.0.4",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
