{
	"name": "friday-tldraw",
	"private": true,
	"version": "1.0.0",
	"description": "Create diagrams, whiteboards, and visual notes on a persistent tldraw canvas in Friday.",
	"keywords": [
		"utility"
	],
	"main": "dist/index.html",
	"files": [
		"dist",
		"manifest.json"
	],
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc --noEmit",
