{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "electron-vite: dev",
      "type": "shell",
      "command": "yarn",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "electron-vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Debugger listening on ws://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
